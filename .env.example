# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- Local models (Ollama on your GPU) — preferred, free -------------------------------
# One-time model download: scripts/setup-local-models.ps1 (Windows) or scripts/setup-local-models.sh
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_SCREEN_MODEL=hf.co/Qwen/Qwen3-8B-GGUF:Q5_K_M
LOCAL_ANALYSIS_MODEL=hf.co/Qwen/Qwen3-14B-GGUF:Q5_K_M
LOCAL_WRITER_MODEL=hf.co/Qwen/Qwen3-14B-GGUF:Q5_K_M
LOCAL_GERMAN_EDITOR_MODEL=mistral-small-3.1-text:q4_k_s
# Model for factual validation of letters; empty = the writer model (Qwen3-14B — much faster than the 24B editor).
LOCAL_VALIDATOR_MODEL=
# Optional humanizer rewrite pass (letters + Humanize page). Gemma-4-12B fine-tune, ~10 GB, local only.
LOCAL_HUMANIZER_MODEL=hf.co/jialinyyzz/humanizer:Q6_K
LOCAL_SCREEN_ENABLED=true
LOCAL_ANALYSIS_ENABLED=true
LOCAL_WRITER_ENABLED=true
LOCAL_GERMAN_EDITOR_ENABLED=true
LOCAL_HUMANIZER_ENABLED=true
# Retry failed local calls on the cloud provider below (costs money; tracked against the daily budget).
CLOUD_FALLBACK_ENABLED=false
# Per-role context size / keep-alive / thinking: config/preferences.yaml → local_llm

# --- Cloud provider (optional): auto | anthropic | openai | heuristic -------------------
# Used for roles that are not enabled locally, and as fallback when CLOUD_FALLBACK_ENABLED=true.
# auto = anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY/OPENAI_BASE_URL is set,
# else a free keyword-based heuristic (no LLM).
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
# Strong model for the final fit analysis, cheap model for triage/extraction.
# Leave empty to use the defaults (claude-opus-5-5 / claude-haiku-4-5).
LLM_ANALYSIS_MODEL=
LLM_TRIAGE_MODEL=
# Server-side refusal fallback for Claude Opus/Sonnet 5.x models (beta). true|false
ANTHROPIC_REFUSAL_FALLBACK=true

# OpenAI or any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenRouter, Azure-compatible proxies...)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# e.g. for Ollama: OPENAI_BASE_URL=http://host.docker.internal:11434/v1  OPENAI_API_KEY=ollama  LLM_ANALYSIS_MODEL=qwen2.5:14b

# --- Email alert ingestion (IMAP). Gmail: enable IMAP + use an App Password. ---------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=*
IMAP_SINCE_DAYS=14

# --- Misc ---------------------------------------------------------------------------
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/jobsearcher   (also add psycopg[binary] to requirements.txt)

# --- Sign-in (set it before the app is reachable from any network) ---------------------------------------------
# APP_PASSWORD=choose-a-long-password

# --- Job platform APIs (free keys; Gulf + international postings from aggregators that index Bayt, GulfTalent,
#     NaukriGulf …) — without them these two sources simply return nothing ------------------------------------------
# CAREERJET_API_KEY=        # https://www.careerjet.com/partners/register/as-publisher
# JOOBLE_API_KEY=           # https://jooble.org/api/about
# REED_API_KEY=             # UK: https://www.reed.co.uk/developers/jobseeker
# ADZUNA_APP_ID=            # UK + Germany: https://developer.adzuna.com
# ADZUNA_APP_KEY=
